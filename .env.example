# --- Mode selection ---
# STANDALONE (bot-less, recommended if you can't invite a bot):
#   Set EVENT_IDS to Raid-Helper message IDs (comma-separated).
#   Right-click Raid-Helper post -> Copy Message ID.
#   Then run: npm run standalone
#   In this mode DISCORD_BOT_TOKEN / GUILD_ID / EVENTS_* are NOT needed.
#   MY_DISCORD_USER_ID is still required (to detect YOUR sign-up).
STANDALONE_MODE=true
EVENT_IDS=1187380378235838548,1185027833676968027

# Discord Bot (only needed for classic auto-discovery mode: npm start)
# Leave empty when using standalone or user-token mode.
DISCORD_BOT_TOKEN=
# Personal-login mode (fully automatic, NO bot invite needed: npm run usertoken).
# Get it: discord.com/app -> F12 Console -> copy(JSON.parse(localStorage.token))
# WARNING: full account access. Never share/commit it. Automating user accounts
# violates Discord ToS (this mode is read-only to keep risk low, but not zero).
DISCORD_USER_TOKEN=
DISCORD_BOT_TOKEN=
GUILD_ID=
# Extra servers (comma-separated) for EVENTS_CATEGORY_IDS lookup across guilds.
# Explicit EVENTS_CHANNEL_IDS already work cross-server without this.
GUILD_IDS=
# Explicit channel IDs to watch (comma-separated)
EVENTS_CHANNEL_IDS=
# Category IDs to watch ALL child channels (comma-separated)
EVENTS_CATEGORY_IDS=
RAIDHELPER_BOT_USER_ID=579155972115660803
MY_DISCORD_USER_ID=

# Sign-up statuses that count as "attending" (comma-separated)
# Default: primary,Accepted,Bench,Late
ATTENDING_STATUSES=primary,Accepted,Bench,Late

# Reminder minutes before event start
REMINDER_MINUTES_BEFORE=15

# How often to poll Raid-Helper API for sign-up changes (minutes)
POLL_INTERVAL_MINUTES=5

# QUIET=true: log only summaries + calendar actions (for Alwaysdata job logs)
QUIET=true
# Pause between Raid-Helper API calls (ms) to avoid 429 rate limits
API_DELAY_MS=1200
# Event length: unset = auto (real end if valid, else start + 2h).
# 0 = zero-duration (end == start, calendar shows start time only).
# N = always start + N minutes, end fields ignored.
#EVENT_DURATION_MINUTES=0

# Your timezone (IANA format)
DEFAULT_TIMEZONE=Asia/Tehran

# Google OAuth (Desktop app type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=